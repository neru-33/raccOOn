# 평가 에이전트 및 실제 AI 리뷰에 사용하는 환경 변수
# 실제 API 키는 로컬 환경에만 설정한다.
EVALUATOR_API_KEY=
EVALUATOR_MODEL=

# 선택: OpenAI 호환 엔드포인트. 비우면 OpenAI 기본 엔드포인트를 사용한다.
EVALUATOR_BASE_URL=

# 선택: ModelClient 구현 클래스(module:Class). 비우면 기본 OpenAI 호환 클라이언트를 사용한다.
EVALUATOR_MODEL_CLIENT=

# 선택: json_schema(기본) 또는 none. none이면 응답 형식 파라미터를 보내지 않고 엔진이 결과 JSON을 검증한다.
EVALUATOR_RESPONSE_FORMAT=json_schema

# 선택: Chat Completions 도구 호출에 reasoning_effort=none이 필요한 모델에서 사용한다.
EVALUATOR_REASONING_EFFORT=
