{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neru-33/raccOOn/contracts/v1/tools.schema.json",
  "title": "모델 도구 인자와 결과",
  "description": "평가 에이전트와 리뷰 세션이 모델에 제공하는 도구. 읽기 도구(read_source, list_files, search_code)는 두 세션이 함께 쓰고 제출본 스냅샷만 읽는다. 리뷰 세션은 읽기 도구만 쓴다. <이름>_args는 함수 parameters, <이름>_result는 호스트가 돌려주는 결과다. 모든 도구는 실패 시 tool_error를 반환할 수 있다. evaluator.contracts.tool_definitions()가 참조를 펼쳐 모델 API용 함수 정의를 만든다.",
  "x-tool-sets": {
    "agent": ["list_files", "search_code", "read_source", "start_submission", "probe_mapping", "run_checks"],
    "review": ["list_files", "search_code", "read_source"]
  },
  "$defs": {
    "tool_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "invalid_arguments",
                "path_denied",
                "not_found",
                "budget_exhausted",
                "not_started",
                "unknown_mapping",
                "execution_error"
              ]
            },
            "message": {"type": "string"}
          }
        }
      }
    },

    "list_files_args": {
      "description": "제출본 스냅샷의 파일 목록을 본다. Git 저장소면 추적 중인 파일(.gitignore 반영)만, 아니면 스냅샷 제외 규칙을 적용한 전체 파일을 돌려준다.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path_prefix": {
          "description": "이 경로로 시작하는 파일만 본다(예: src/). 생략하면 전체.",
          "type": "string"
        }
      }
    },
    "list_files_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "files", "truncated"],
      "properties": {
        "source": {
          "description": "git: git ls-files 결과. walk: 디렉터리 순회 결과.",
          "enum": ["git", "walk"]
        },
        "files": {
          "description": "경로순 정렬. 최대 2,000개.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "lines"],
            "properties": {
              "path": {"$ref": "common.schema.json#/$defs/relative_path"},
              "lines": {
                "description": "텍스트 파일의 줄 수. 바이너리는 null.",
                "type": ["integer", "null"]
              }
            }
          }
        },
        "truncated": {"type": "boolean"}
      }
    },

    "search_code_args": {
      "description": "제출본 스냅샷의 텍스트 파일에서 문자열을 찾는다. 정규식이 아닌 고정 문자열을 대소문자 구분 없이 찾는다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "path_prefix": {
          "description": "이 경로로 시작하는 파일에서만 찾는다. 생략하면 전체.",
          "type": "string"
        }
      }
    },
    "search_code_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matches", "truncated"],
      "properties": {
        "matches": {
          "description": "경로·줄 번호순. 최대 100건, 각 줄은 300자에서 자른다.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "line", "text"],
            "properties": {
              "path": {"$ref": "common.schema.json#/$defs/relative_path"},
              "line": {"type": "integer", "minimum": 1},
              "text": {"type": "string"}
            }
          }
        },
        "truncated": {"type": "boolean"}
      }
    },

    "read_source_args": {
      "description": "제출본 스냅샷 안의 텍스트 파일을 줄 번호와 함께 읽는다. 한 번에 최대 400줄. 비밀 파일과 스냅샷 밖 경로는 거부된다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "description": "스냅샷 기준 POSIX 상대 경로",
          "type": "string"
        },
        "start_line": {
          "description": "읽기 시작할 줄(1부터, 포함). 생략하면 1.",
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "description": "마지막 줄(포함). 생략하면 start_line부터 최대 400줄.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "read_source_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line", "content", "total_lines", "truncated"],
      "properties": {
        "path": {"$ref": "common.schema.json#/$defs/relative_path"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {
          "description": "실제로 돌려준 마지막 줄. 빈 파일이면 0.",
          "type": "integer",
          "minimum": 0
        },
        "content": {
          "description": "각 줄을 \"<원본 파일 기준 줄 번호>\\t<내용>\" 형식으로 이어 붙인 문자열. 줄 번호는 1부터 센다. 한 줄이 2,000자를 넘으면 그 줄을 자른다.",
          "type": "string"
        },
        "total_lines": {"type": "integer", "minimum": 0},
        "truncated": {
          "description": "요청 범위가 400줄을 넘었거나 줄을 자른 경우 true",
          "type": "boolean"
        }
      }
    },

    "start_submission_args": {
      "description": "현재 제출본으로 평가 환경을 기동하고 제출물·의존 서비스·평가 도구의 준비 상태를 확인한다. 실행 중인 제출물에서 얻은 사용법 자료(예: OpenAPI 문서)가 있으면 함께 반환한다.",
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "start_submission_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "discovered", "tools", "error"],
      "properties": {
        "status": {"enum": ["ready", "error"]},
        "discovered": {
          "description": "실행기가 실행 중인 제출물에서 수집한 사용법 자료. 없으면 빈 배열.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "location", "document", "truncated"],
            "properties": {
              "kind": {
                "description": "자료 종류. http 실행기는 openapi를 사용한다.",
                "type": "string"
              },
              "location": {
                "description": "자료를 얻은 위치(예: 앱 기준 경로 /openapi.json)",
                "type": ["string", "null"]
              },
              "document": {
                "description": "자료 본문. 크기 제한을 넘으면 요약하고 truncated=true.",
                "type": ["object", "string", "null"]
              },
              "truncated": {"type": "boolean"}
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "available"],
            "properties": {
              "id": {"type": "string"},
              "version": {"type": ["string", "null"]},
              "available": {"type": "boolean"}
            }
          }
        },
        "error": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "message", "cause", "log_excerpt"],
              "properties": {
                "stage": {"type": "string"},
                "message": {"type": "string"},
                "cause": {
                  "description": "environment: 실행기 자체 인프라 확인 실패. submission: 인프라는 정상이나 제출물이 기동·준비되지 않음.",
                  "enum": ["environment", "submission"]
                },
                "log_excerpt": {
                  "description": "제출물 또는 인프라 로그의 끝부분(최대 4,000자), 없으면 null",
                  "type": ["string", "null"]
                }
              }
            }
          ]
        }
      }
    },

    "probe_mapping_args": {
      "description": "논리 동작별 API 호출 후보를 제출한다. 실행기가 시험용 데이터로 동작을 순서대로 호출해 상태 코드, 응답 필드 해석, 동작 간 ID 연결을 확인하고, 통과하면 mapping_id를 발급한다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate"],
      "properties": {
        "candidate": {"$ref": "mapping-candidate.schema.json"},
        "documented_operations": {
          "description": "제출물 문서(README 등)에 적힌 호출법을 동작별로 문서에 적힌 그대로 전달한다. candidate와 달라도 된다. 실행기는 마지막으로 받은 값을 mapping.json에 기록하고 시험 이력과 대조해 문서 호출법의 시험 결과를 판정한다.",
          "type": "object",
          "propertyNames": {"$ref": "common.schema.json#/$defs/operation_name"},
          "additionalProperties": {"$ref": "mapping.schema.json#/$defs/documented_call_input"}
        }
      }
    },
    "probe_mapping_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mapping_id",
        "probe_attempts",
        "failed_stage",
        "failed_operation",
        "http_status",
        "message",
        "response_excerpt"
      ],
      "properties": {
        "status": {"enum": ["verified", "failed"]},
        "mapping_id": {"type": ["string", "null"]},
        "probe_attempts": {
          "description": "이번 실행에서 누적된 시험 횟수",
          "type": "integer",
          "minimum": 1
        },
        "failed_stage": {"$ref": "mapping.schema.json#/$defs/probe_stage"},
        "failed_operation": {"type": ["string", "null"]},
        "http_status": {"type": ["integer", "null"]},
        "message": {"type": ["string", "null"]},
        "response_excerpt": {
          "description": "실패한 응답 본문 앞부분(최대 2,000자)",
          "type": ["string", "null"]
        }
      }
    },

    "run_checks_args": {
      "description": "확인된 매핑으로 과제에 선언된 필수 검사를 모두 실행한다. 호출 후 관제 세션은 종료된다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_id"],
      "properties": {
        "mapping_id": {
          "description": "probe_mapping이 발급한 ID. 과제에 연결할 논리 동작이 없으면 null.",
          "type": ["string", "null"]
        }
      }
    },
    "run_checks_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observation_count", "error"],
      "properties": {
        "status": {"enum": ["complete", "execution_error"]},
        "observation_count": {"type": "integer", "minimum": 0},
        "error": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "message"],
              "properties": {
                "stage": {"type": "string"},
                "message": {"type": "string"}
              }
            }
          ]
        }
      }
    }
  }
}
