{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neru-33/raccOOn/contracts/v1/runtime.schema.json",
  "title": "모듈 간 전달 객체",
  "description": "CLI가 모듈을 호출할 때 주고받는 객체. 파일로 저장하지 않아도 같은 구조를 따른다.",
  "$defs": {
    "run_meta": {
      "description": "CLI가 실행마다 한 번 만들고 실행기·리뷰·코어가 재사용하는 공통 봉투",
      "type": "object",
      "allOf": [{"$ref": "common.schema.json#/$defs/envelope"}],
      "properties": {
        "schema_version": true,
        "run_id": true,
        "task_id": true,
        "submission_sha256": true
      },
      "unevaluatedProperties": false
    },
    "orchestration_result": {
      "description": "evaluator.agent.orchestrate()의 반환값. 해당하지 않는 값은 null.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_status", "probe_attempts", "mapping_artifact", "observations", "model_info", "error"],
      "properties": {
        "mapping_status": {"$ref": "common.schema.json#/$defs/mapping_status"},
        "probe_attempts": {"type": "integer", "minimum": 0},
        "mapping_artifact": {
          "oneOf": [{"type": "null"}, {"$ref": "mapping.schema.json"}]
        },
        "observations": {
          "oneOf": [{"type": "null"}, {"$ref": "observations.schema.json"}]
        },
        "model_info": {
          "oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/model_info"}]
        },
        "error": {
          "oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/error"}]
        }
      }
    },
    "review_result": {
      "description": "evaluator.review.review()의 반환값. 리포트에서는 review_artifact가 파일 이름으로 바뀐다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "review_artifact", "error"],
      "properties": {
        "status": {"$ref": "common.schema.json#/$defs/review_status"},
        "review_artifact": {
          "oneOf": [{"type": "null"}, {"$ref": "ai-review.schema.json"}]
        },
        "error": {
          "oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/error"}]
        }
      }
    }
  }
}
