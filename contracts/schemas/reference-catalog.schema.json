{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neru-33/raccOOn/contracts/v1/reference-catalog.schema.json",
  "title": "공식 문서 카탈로그",
  "description": "리뷰 세션의 lookup_reference 도구가 읽는 출제자 소유 문서 목록. 세션 시작 시 id와 section_title만 제공하고, 본문은 도구 호출로 전달한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "references"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "technology", "version", "section_title", "url", "text"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/identifier"},
          "technology": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "section_title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
