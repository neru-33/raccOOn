{
  "schema_version": 1,
  "task_id": "reservation-v1",
  "task_summary": "정원이 있는 이벤트의 예약 생성과 예약 확정 상태 조회 API. 마지막 한 자리에 동시에 여러 요청이 들어와도 예약은 한 건만 확정되어야 한다.",
  "runner_id": "compose-postgres-k6",
  "runner_config": {
    "database": {
      "mode": "engine_managed"
    },
    "tools": [
      {"id": "postgres", "image": "postgres:16"},
      {"id": "k6", "image": "grafana/k6:1.0.0", "options": {"batch": 50, "batchPerHost": 50}}
    ],
    "app": {
      "compose_file": "compose.yaml",
      "service": "app",
      "port": 8080,
      "ready_timeout_seconds": 60,
      "env": [
        {
          "name": "DATABASE_URL",
          "format": "postgresql://<user>:<password>@<host>:<port>/<database>",
          "description": "평가 환경이 제공하는 테스트 DB 접속 정보"
        }
      ]
    },
    "probe": {
      "event_capacity": 5
    },
    "scenarios": {
      "reservation.functional": {
        "event_capacity": 5
      },
      "reservation.concurrent": {
        "event_capacity": 1,
        "requests": 50,
        "request_timeout_seconds": 10
      }
    }
  },
  "operations": {
    "create_reservation": {
      "description": "사용자가 이벤트 좌석 하나를 예약한다.",
      "inputs": {
        "event_id": {"type": "id", "description": "예약할 이벤트 ID"},
        "user_id": {"type": "id", "description": "예약하는 사용자 ID"}
      },
      "outputs": {
        "reservation_id": {"type": "id", "description": "생성된 예약 ID"},
        "confirmed": {"type": "bool", "description": "예약이 확정되었는지 여부"}
      }
    },
    "get_reservation": {
      "description": "예약 ID로 예약과 확정 상태를 조회한다.",
      "inputs": {
        "reservation_id": {
          "type": "id",
          "description": "조회할 예약 ID",
          "from": "create_reservation.reservation_id"
        }
      },
      "outputs": {
        "reservation_id": {"type": "id", "description": "조회된 예약 ID"},
        "confirmed": {"type": "bool", "description": "예약이 확정되었는지 여부"}
      }
    }
  },
  "metrics": {
    "reservation.functional": {
      "rounds": [1],
      "values": {"created": "bool", "retrieved": "bool"}
    },
    "reservation.concurrent": {
      "rounds": [1, 2, 3],
      "values": {"confirmed_responses": "int", "persisted_confirmed": "int"}
    }
  },
  "rules": [
    {
      "id": "functional.create",
      "type": "award_if",
      "description": "정상 예약 생성",
      "test_id": "reservation.functional",
      "round": 1,
      "points": 8,
      "conditions": [{"metric": "created", "op": "eq", "value": true}]
    },
    {
      "id": "functional.retrieve",
      "type": "award_if",
      "description": "생성한 예약의 상태 조회",
      "test_id": "reservation.functional",
      "round": 1,
      "points": 8,
      "conditions": [{"metric": "retrieved", "op": "eq", "value": true}]
    },
    {
      "id": "concurrent.single_confirmation",
      "type": "award_per_round",
      "description": "정원 1인 이벤트에 동시 요청 50건, 회차마다 확정 1건",
      "test_id": "reservation.concurrent",
      "points": 8,
      "veto_if_any_round": [{"metric": "persisted_confirmed", "op": "gte", "value": 2}],
      "conditions": [
        {"metric": "confirmed_responses", "op": "eq", "value": 1},
        {"metric": "persisted_confirmed", "op": "eq", "value": 1}
      ]
    }
  ],
  "score_limits": {
    "functional": 40,
    "quality": 60
  },
  "quality_rubric": [
    {
      "id": "architecture",
      "title": "아키텍처",
      "kind": "general",
      "levels": {
        "needs_improvement": "예약 규칙이 적용되는 위치나 저장 책임을 추적하기 어렵다.",
        "meets": "예약 규칙이 적용되는 위치와 저장 책임을 추적할 수 있다.",
        "strong": "선택한 구조가 예상 변경이나 장애 상황을 어떻게 다루는지 코드 근거로 설명할 수 있다."
      },
      "max_points": 15,
      "points_by_rating": {"needs_improvement": 5, "meets": 10, "strong": 15}
    },
    {
      "id": "code_quality",
      "title": "코드 품질",
      "kind": "general",
      "levels": {
        "needs_improvement": "주요 처리 흐름이나 실패 처리를 읽기 어렵고 수정 지점을 찾기 어렵다.",
        "meets": "주요 처리 흐름과 실패 처리가 읽히고 수정 지점을 찾을 수 있다.",
        "strong": "예약 불변식이 일관되게 적용되고 중요한 경계 조건을 테스트가 다룬다."
      },
      "max_points": 20,
      "points_by_rating": {"needs_improvement": 7, "meets": 14, "strong": 20}
    },
    {
      "id": "documentation",
      "title": "문서 품질",
      "kind": "general",
      "levels": {
        "needs_improvement": "문서만으로 실행이나 API 호출을 재현할 수 없다.",
        "meets": "실행 방법과 실제 API 사용 예시가 있어 평가를 재현할 수 있다.",
        "strong": "대표 실패 응답, 검증 방법, 설계 결정과 제약이 구현에 맞게 설명된다."
      },
      "max_points": 15,
      "points_by_rating": {"needs_improvement": 5, "meets": 10, "strong": 15}
    },
    {
      "id": "extra_feature",
      "title": "추가 기능",
      "kind": "extra_feature",
      "levels": {
        "needs_improvement": "추가 기능의 목적이나 구현 경로가 불분명하다.",
        "meets": "필수 범위를 넘는 기능이 과제 맥락에서 의미 있고 구현 경로가 확인된다.",
        "strong": "실제 사용자가 겪을 문제를 해결하고 예외 처리와 확인 근거가 있다."
      },
      "max_points": 10,
      "points_by_rating": {"needs_improvement": 3, "meets": 7, "strong": 10, "not_applicable": 0},
      "verification_rules": []
    }
  ],
  "review_instructions": "과제 루브릭의 각 항목을 독립적으로 판정한다. 판정마다 제출 코드·문서의 파일과 줄 범위를 근거로 붙인다. 실행 결과를 근거로 쓸 때는 observation_refs에 검사 ID, 회차, 지표를 지정한다. 결함의 원인을 설명할 때는 관련 코드 위치와 함께 hypotheses에 가설로 남긴다. 특정 프레임워크, 레이어 수, 문서 분량, 기능 개수 자체는 우수 판정의 근거로 쓰지 않는다."
}
